    "react-upgrade": "^0.1.0",
    "tdollar": "^0.6.0"
  },
  "devDependencies": {
    "@storybook/react": "^9.1.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@wrkspc/ts": "workspace:*",
    "typescript": "^5.9.3"
  }
