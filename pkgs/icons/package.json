{
  "name": "@wrkspc/icons",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./svg/*": "./dist/*"
  },
  "scripts": {
    "build": "test -z $TURBO_HASH && turbo run build || echo OK",
    "build/import": "./scripts/import.sh",
    "build/generate": "./scripts/generate.ts",
    "types": "$(pnpm root -w)/../scripts/pkg-types.sh || tsc",
    "types:watch": "$(pnpm root -w)/../scripts/pkg-types.sh watch || tsc --watch"
  },
  "dependencies": {
    "@wrkspc/theme": "workspace:*",
    "crab": "^1.12.0",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@wrkspc/ts": "workspace:*",
    "glob": "^11.0.3",
    "typescript": "^5.9.3"
  }
}
