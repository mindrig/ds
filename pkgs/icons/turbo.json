{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "setup": {
      "dependsOn": ["build"]
    },

    "build": {
      "dependsOn": ["build/generate"]
    },

    "build/generate": {
      "dependsOn": ["build/import"],
      "inputs": ["$TURBO_DEFAULT$", "./scripts/generate.ts", "./dist/**/*.svg"],
      "outputs": ["./dist/**/*.ts"]
    },

    "build/import": {
      "dependsOn": ["//#install/npm"],
      "inputs": ["$TURBO_DEFAULT$", "./.fontawesomerc", "./scripts/import.sh"],
      "outputs": ["./dist/**/*.svg"],
      "env": ["FONTAWESOME_PACKAGE_TOKEN"]
    }
  },
  "extends": ["//"]
}
